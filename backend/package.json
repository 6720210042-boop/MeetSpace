{
  "name": "meetspace-backend",
  "version": "1.0.0",
  "description": "MeetSpace - University Meeting Room Booking System Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seedUsers.js",
    "migrate": "node src/scripts/migrateMySQL.js",
    "seed:rooms": "node src/scripts/seedRooms.js",
    "test": "jest",
    "coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "google-auth-library": "^8.8.0",
    "jsonwebtoken": "^9.0.0",
    "mysql2": "^3.3.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^2.0.20"
  }
}
